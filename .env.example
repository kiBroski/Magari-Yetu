# --- Core ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional public profile URLs used by the website footer. If omitted, the
# corresponding footer button sends visitors to the contact page instead.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
PAYLOAD_SECRET=              # long random string, `openssl rand -base64 32`
DATABASE_URI=postgresql://postgres:[YOUR_PASSWORD]@your-postgres-host:5432/postgres # Postgres connection string — Supabase, Neon, or Railway all work

# --- Image / file storage (production) ---
# Pick ONE adapter in src/collections/Media.ts's upload config once you're
# past local dev. Vercel Blob is the least setup for a Vercel deploy;
# Cloudflare R2 is the cheapest at scale.
BLOB_READ_WRITE_TOKEN=
# or: R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= / R2_BUCKET= / R2_ENDPOINT=

# --- Payments: Safaricom Daraja (direct M-Pesa STK push, no aggregator) ---
# From developer.safaricom.co.ke — sandbox credentials are free and instant
# using their default test shortcode (174379) and published test passkey;
# a real MPESA_SHORTCODE (Paybill/Till) requires business registration
# documents submitted to Safaricom before it'll take real money.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=            # 174379 for sandbox testing
MPESA_PASSKEY=              # Safaricom's published sandbox passkey for testing; your own once the real shortcode is approved
MPESA_ENV=sandbox           # 'production' switches to api.safaricom.co.ke
# No separate callback-URL env var — src/lib/mpesa.ts builds it from
# NEXT_PUBLIC_SERVER_URL, which MUST be a real public HTTPS address for
# Daraja to accept it. localhost will not work; tunnel (e.g. ngrok) or test
# against a deployed staging URL.

# --- WhatsApp click-to-chat (no API needed, just the business number) ---
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=2547XXXXXXXX
# WhatsApp Cloud API webhook (Meta dashboard → /api/whatsapp/webhook).
# Keep these server-only; the webhook validates x-hub-signature-256.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Meta Cloud API sender credentials. Create these in the Meta developer
# dashboard; keep the permanent access token server-side only.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CLAIM_SECRET=

# --- SMS: Africa's Talking (phone-OTP login + seller lead notifications) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_ENV=sandbox              # 'production' switches to the live API base URL
OTP_HASH_SECRET=            # long random string, `openssl rand -base64 32` — peppers the OTP hash

# --- Email (verification, password reset, lead notifications) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@magariyetu.co.ke

# --- Production abuse protection ---
# Set Turnstile on the public forms. The backend remains usable locally when
# this is absent; production deployment must require it and a shared limiter.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# A Redis/Upstash-compatible endpoint for the shared production rate limiter.
# The current in-process limiter is deliberately only a local fallback.
RATE_LIMIT_REDIS_URL=

# --- Private verification documents ---
# Store verification files in a separate private bucket and issue short-lived
# moderator-only signed URLs through the deployment storage provider.
PRIVATE_DOCUMENTS_BUCKET=
